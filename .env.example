# GitHub OAuth 2.0 App Credentials
GITHUB_CLIENT_ID="seu_github_client_id"
GITHUB_CLIENT_SECRET="seu_github_client_secret"

# Supabase PostgreSQL Connections
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Public Client Keys
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sua_supabase_publishable_key"

# Base URL da Aplicação (usada para OpenGraph / Twitter Cards e OAuth Redirect)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
